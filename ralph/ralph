#!/usr/bin/env bash
# ralph — the Ralph Wiggum loop: a dumb orchestrator that spends one clean
# one clean harness session per forward step and keeps every scrap of continuity on disk
# (the prompt's own list file, ralph/progress.txt, git history), so a session starts
# fresh and reads state rather than inheriting it.
#
# The loop: one session per item on that list, running while sessions answer
# <promise>NEXT</promise>, until one answers <promise>COMPLETE</promise>.
#
# The prompt file is the single tuning surface — it is piped in verbatim with
# [ralph-iteration] substituted, so editing it steers the very next iteration.
# It lives in ralph/ and defaults to prompt-build.md; -p names a different one
# (prompt-plan.md, …), which is how one orchestrator drives
# three different loops without a second copy of this script.
#
# TOOL SET — validated 2026-07-24 by asking a live browser-enabled session
# to enumerate its own tools. The default grant is already complete: Agent, Bash,
# Read, Edit, Write, Skill, ToolSearch, Task*, Monitor, WebFetch, WebSearch and the
# browser automation tools (computer, navigate, read_page, tabs_*, find,
# javascript_tool, read_console_messages, ...). Nothing was missing, so this script
# passes NO --tools/--allowedTools filter: any such flag could only ever shrink that
# set. Do not add one. The same holds for pi: its grant is the built-in read/bash/
# edit/write set plus every extension the user installed (the Agent tool, background
# tasks, web access), and a --tools allowlist could only remove one of them.
#
# Usage:  ralph/ralph [options]
#   -n, --iterations N      max ralph iterations (0 = unlimited, default 0)
#   -p, --prompt FILE       prompt file inside ralph/ (default prompt-build.md)
#   --harness H             execution harness: pi (default), codex or claude
#   -m, --model M           model alias for every session (pi default
#                           anthropic/claude-haiku-4-5; codex default gpt-5.6-luna;
#                           claude default sonnet)
#   -t, --thinking LEVEL    thinking level per session: low|medium|high|xhigh|max;
#                           pi also takes off|minimal and defaults to off (for codex and
#                           claude, unset = the CLI's own default, whatever /effort last saved)
#   -w, --watchdog SECS     kill a session after SECS with no progress.txt append (0 = off, default)
#                           (default 2700 = the 45 min prompt-build.md promises; 0 disables)
#   -b, --budget USD        per-session USD cap (pi and Codex are checked from the
#                           transcript's own usage; Claude enforces it in the CLI)
#   -B, --budget-total USD  stop the whole run once less than $2 of this remains
#   -h, --help
set -uo pipefail

# Job control in a script: every background job gets its OWN process group, and
# anything it spawns inherits that group. That is what makes a session's whole
# tree — including subagents it launched — addressable as one unit, both to wait
# for and to kill. Verified: a grandchild of a backgrounded job stays alive after
# `wait` on that job returns, which is precisely how a subagent outlived a
# ralph iteration and reported in long after the script had moved on.
set -m

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$REPO_ROOT" || exit 1

PROGRESS="ralph/progress.txt"

# Every invocation writes into its own directory under ralph/.run/, keyed by the
# UTC time it started. Session files are numbered from 001 within a run, so two
# runs sharing one flat directory would silently overwrite each other's
# transcripts — namespacing removes that entirely. Kept runs live in ralph/.archive/.
RUN_ID="$(date -u +%Y%m%dT%H%M%SZ)"
RUNDIR="ralph/.run/$RUN_ID"
HARNESS="${RALPH_HARNESS:-pi}"
MODEL="${RALPH_MODEL:-}"
# The prompt file, by NAME, inside ralph/. A basename only —
# it is resolved under ralph/, so a path cannot point the loop outside the run kit.
PROMPT_NAME="${RALPH_PROMPT:-prompt-build.md}"
# Empty = pass no thinking override and inherit the selected CLI's configured default.
THINKING="${RALPH_THINKING:-}"
MAX_ITER="${RALPH_MAX_ITER:-0}"
# 0 = disabled (the default). A long, quiet stretch is normal work — a full verify, a wide
# refactor, a Chrome sweep — not a hang, and killing it mid-iteration threw away real progress.
# Set RALPH_WATCHDOG_SECS or -w to re-arm it.
WATCHDOG="${RALPH_WATCHDOG_SECS:-0}"
BUDGET_USD="${RALPH_MAX_BUDGET_USD:-}"
BUDGET_TOTAL_USD="${RALPH_BUDGET_TOTAL_USD:-}"
BUDGET_RESERVE_USD="${RALPH_BUDGET_RESERVE_USD:-2.00}"
GROUP_WAIT_MAX="${RALPH_GROUP_WAIT_MAX:-900}"
RESUME_MAX="${RALPH_RESUME_MAX:-4}"      # resumes allowed within one iteration

while [[ $# -gt 0 ]]; do
  case "$1" in
    -n|--iterations)     MAX_ITER="$2"; shift 2 ;;
    -p|--prompt)         PROMPT_NAME="$2"; shift 2 ;;
    -m|--model)          MODEL="$2"; shift 2 ;;
    --harness)           HARNESS="$2"; shift 2 ;;
    -t|--thinking)       THINKING="$2"; shift 2 ;;
    -w|--watchdog)       WATCHDOG="$2"; shift 2 ;;
    -b|--budget)         BUDGET_USD="$2"; shift 2 ;;
    -B|--budget-total)   BUDGET_TOTAL_USD="$2"; shift 2 ;;
    -h|--help)           sed -n '2,41p' "${BASH_SOURCE[0]}"; exit 0 ;;
    *) echo "ralph: unknown option $1 (try --help)" >&2; exit 2 ;;
  esac
done

# pi is the only harness with a fixed thinking default: its own default is whatever the
# model catalogue says, which differs per model, so ralph pins "off" and the ledger
# always names a level. Codex and Claude keep inheriting their CLI's saved default.
case "$HARNESS" in
  pi)     [[ -n "$MODEL" ]] || MODEL="anthropic/claude-haiku-4-5"
          [[ -n "$THINKING" ]] || THINKING="off" ;;
  codex)  [[ -n "$MODEL" ]] || MODEL="gpt-5.6-luna" ;;
  claude) [[ -n "$MODEL" ]] || MODEL="sonnet" ;;
  *) echo "ralph: --harness must be pi, codex or claude (got '$HARNESS')" >&2; exit 2 ;;
esac

# pi's thinking scale has two levels below "low" that the other CLIs cannot express.
if [[ "$HARNESS" == pi ]]; then
  case "$THINKING" in
    off|minimal|low|medium|high|xhigh|max) ;;
    *) echo "ralph: --thinking must be one of off minimal low medium high xhigh max (got '$THINKING')" >&2; exit 2 ;;
  esac
else
  case "$THINKING" in
    ""|low|medium|high|xhigh|max) ;;
    *) echo "ralph: --thinking must be one of low medium high xhigh max (got '$THINKING')" >&2; exit 2 ;;
  esac
fi

case "$HARNESS" in
  pi)     command -v pi     >/dev/null || { echo "ralph: pi CLI not on PATH" >&2; exit 1; } ;;
  codex)  command -v codex  >/dev/null || { echo "ralph: codex CLI not on PATH" >&2; exit 1; } ;;
  claude) command -v claude >/dev/null || { echo "ralph: claude CLI not on PATH" >&2; exit 1; } ;;
esac
command -v python3 >/dev/null || { echo "ralph: python3 required (no jq on this box)" >&2; exit 1; }
PROMPT_NAME="$(basename "$PROMPT_NAME")"
PROMPT_FILE="ralph/$PROMPT_NAME"
[[ -f "$PROMPT_FILE" ]] || { echo "ralph: $PROMPT_FILE missing" >&2; exit 1; }
mkdir -p "$RUNDIR"
touch "$PROGRESS"
git rev-parse --abbrev-ref HEAD > ralph/.last-branch 2>/dev/null || true

# The thinking level is NOT written to the session JSON — only to the transcript, on
# every assistant record. So the ledger has to carry it, or a past run's entry cannot
# be told apart from one at a different level.
MODEL_LABEL="$MODEL"
[[ -n "$THINKING" ]] && MODEL_LABEL="$MODEL thinking=$THINKING"
# The ledger keeps model and thinking level as two separate bracketed fields —
# "[opus] [low]" — so the model field reads the same whether or not a level was
# chosen. Unset prints no second bracket rather than an empty one.
THINKING_TAG=""
[[ -n "$THINKING" ]] && THINKING_TAG=" [$THINKING]"

if [[ "$HARNESS" == pi ]]; then
  # --mode json streams the session header (id, cwd) and every message as JSONL on
  # stdout, which is how the session transcript under ~/.pi/agent/sessions is found
  # afterwards. pi has no permission prompts and no budget flag: the per-session cap is
  # checked from the transcript's own cost figures, the same way Codex is.
  HARNESS_ARGS=( -p --mode json --model "$MODEL" --thinking "$THINKING" )
elif [[ "$HARNESS" == codex ]]; then
  HARNESS_ARGS=( --yolo --json -m "$MODEL" )
  # Codex and Claude each call the level by their own name on the command line.
  [[ -n "$THINKING" ]] && HARNESS_ARGS+=( -c "model_reasoning_effort=$THINKING" )
  HARNESS_ARGS+=(
    -c "agents.max_depth=32"
    -c "agents.max_concurrent_threads_per_session=32"
    -c "features.goals=false"
    -c "tool_output_token_limit=40000"
    -c "model_context_window=1050000"
    -c "model_auto_compact_token_limit=997500"
  )
else
  HARNESS_ARGS=( -p --dangerously-skip-permissions --chrome --model "$MODEL" --output-format json )
  [[ -n "$THINKING" ]] && HARNESS_ARGS+=( --effort "$THINKING" )
  [[ -n "$BUDGET_USD" ]] && HARNESS_ARGS+=( --max-budget-usd "$BUDGET_USD" )
fi

# ── small helpers ────────────────────────────────────────────────────────────

say()  { printf '[ralph %s] %s\n' "$(date -u +%H:%M:%S)" "$*" >&2; }

# Human session duration: "1h45min" over an hour, "45min" under. Measured on the
# wall clock in run_session — the session JSON's duration_ms is NOT usable (it
# reported 157840ms for a session that ran 31 minutes).
fmt_dur() { # <seconds>
  local s="${1:-0}" h m
  h=$(( s / 3600 )); m=$(( (s % 3600 + 30) / 60 ))
  (( m == 60 )) && { h=$(( h + 1 )); m=0; }
  if (( h > 0 )); then printf '%dh%02dmin' "$h" "$m"; else printf '%dmin' "$m"; fi
}
note() { printf '\n%s\n' "$*" >> "$PROGRESS"; }

# jsonfield <file> <dotted.path> — python3 stands in for jq, which is absent here.
jsonfield() {
  python3 - "$1" "$2" <<'PY'
import json, sys
try:
    d = json.load(open(sys.argv[1]))
except Exception:
    sys.exit(1)
for k in sys.argv[2].split('.'):
    if isinstance(d, dict) and k in d:
        d = d[k]
    else:
        sys.exit(1)
print(d if not isinstance(d, (dict, list)) else json.dumps(d))
PY
}

promise_of() {
  grep -oE '<promise>(NEXT|COMPLETE)</promise>' <<<"${1:-}" | tail -1 |
    sed -E 's#</?promise>##g'
}

# ── session runner: one headless harness turn, watchdogged on progress.txt ───

SESSION_N=0
LAST_JSON=""
LAST_RAW_JSON=""
USAGE_DEFERRED=0
ITER_JSONS=()
ITER_SECS=0
ITER_COST_START=0

# Start a fresh usage accumulation for one iteration.
begin_iteration_usage() {
  ITER_JSONS=(); ITER_SECS=0; USAGE_DEFERRED=1
  ITER_COST_START="$(spent_usd)"
}

# Emit the single ledger entry for the iteration just finished.
flush_iteration_usage() { # <label>
  USAGE_DEFERRED=0
  (( ${#ITER_JSONS[@]} )) || return 0
  SESSION_SECS="$ITER_SECS"
  log_usage "$1" "${ITER_JSONS[@]}"
  ITER_JSONS=(); ITER_SECS=0
}

session_budget_exhausted() {
  [[ "$HARNESS" == claude || -z "$BUDGET_USD" ]] && return 1
python3 - "$ITER_COST_START" "$BUDGET_USD" "$COST_FILE" <<'PY'
import sys
start, limit, path = float(sys.argv[1]), float(sys.argv[2]), sys.argv[3]
spent = sum(float(line) for line in open(path) if line.strip())
sys.exit(0 if spent - start > limit else 1)
PY
}
# run_session hands its result back through a FILE, never stdout: wrapping it in
# $( ) would run it in a subshell and discard every variable it sets — session
# numbering would reset each call and collide transcripts, and the cost ledger
# would total $0. Costs also accumulate in a file, so the total survives however
# a caller invokes it.
RESULT_FILE="$RUNDIR/last-result.txt"
COST_FILE="$RUNDIR/costs.txt"
: > "$COST_FILE"

spent_usd() { # total cost so far, summed from the ledger file
  python3 -c "
print(f\"{sum(float(l) for l in open('$COST_FILE') if l.strip()):.4f}\")" 2>/dev/null || echo 0
}

# Returns 0 when --budget-total leaves too little headroom to start another
# session, so the loop can stop cleanly instead of dying mid-iteration.
budget_exhausted() {
  [[ -z "$BUDGET_TOTAL_USD" ]] && return 1
  python3 -c "
import sys
spent = sum(float(l) for l in open('$COST_FILE') if l.strip())
sys.exit(0 if (float('$BUDGET_TOTAL_USD') - spent) < float('$BUDGET_RESERVE_USD') else 1)"
}

# Every session process group started this run, so cleanup can reap all of them.
SESSION_PGIDS=""

# Stopping ralph must take its sessions with it. Without this a SIGTERM to the
# loop leaves the in-flight `claude -p` — and any subagent it spawned — running
# and reparented to init, still writing to the repo with nothing supervising it.
# Killing the process GROUP rather than the pid is what reaches the subagents.
group_members() { # <pgid> -> pids still alive in that group
  [ -n "${1:-}" ] || return 0
  pgrep -g "$1" 2>/dev/null | tr '\n' ' '
}

reap_sessions() {
  local pgid members
  for pgid in $SESSION_PGIDS; do
    members="$(group_members "$pgid")"
    [ -n "$members" ] || continue
    say "stopping session group $pgid (${members% })"
    kill -TERM -"$pgid" 2>/dev/null || true
  done
  sleep 2
  for pgid in $SESSION_PGIDS; do
    [ -n "$(group_members "$pgid")" ] && kill -KILL -"$pgid" 2>/dev/null || true
  done
}
trap 'reap_sessions; exit 130' INT
trap 'reap_sessions; exit 143' TERM
trap 'reap_sessions' EXIT


# After a session's own claude exits, subagents it spawned can still be running.
# Wait for them: their work lands in the repo, and letting the next iteration
# start on top of a half-written tree is how uncommitted work goes missing.
await_group() { # <pgid> <label>
  local pgid="${1:-}" label="${2:-}" waited=0 members
  [ -n "$pgid" ] || return 0
  members="$(group_members "$pgid")"
  [ -n "$members" ] || return 0
  say "session [$label] exited but left work running (${members% }) — waiting"
  note "[ralph] session [$label] exited with subagent work still running; waiting for it before the next iteration."
  while [ -n "$(group_members "$pgid")" ]; do
    sleep 5
    waited=$(( waited + 5 ))
    if (( waited >= GROUP_WAIT_MAX )); then
      say "still running after ${waited}s — terminating group $pgid"
      note "[ralph] leftover work in session [$label] did not finish within ${waited}s; terminated."
      kill -TERM -"$pgid" 2>/dev/null || true
      sleep 5
      kill -KILL -"$pgid" 2>/dev/null || true
      return 0
    fi
  done
  say "leftover work in [$label] finished after ${waited}s"
}

# The CLI process exiting is necessary but not sufficient to accept its promise.
# Both harnesses can leave work outside that process: Codex persists spawned-agent
# turns in its local state store, and Claude exposes background agents separately.
# A promise from a parent that still has either kind of work is a progress report,
# not the end of an iteration.
codex_pending_work() { # <Codex JSONL from this invocation>; stdout = reasons
  local source="${1:-}"
  RALPH_CODEX_SOURCE="$source" python3 - <<'PY'
import datetime, json, os, sqlite3

source = os.environ.get("RALPH_CODEX_SOURCE", "")
def events(path):
    try:
        with open(path, errors="replace") as fh:
            for line in fh:
                try:
                    outer = json.loads(line)
                except (TypeError, ValueError):
                    continue
                payload = outer.get("payload")
                event = dict(payload) if isinstance(payload, dict) else dict(outer)
                event["_ralph_timestamp"] = outer.get("timestamp") or event.get("timestamp")
                yield event
    except OSError:
        return

root_events = list(events(source))
if not root_events:
    print("Codex session record is unavailable")
    raise SystemExit(0)

root = None
turn_finished = False
reported_children = {}
terminal_agent_statuses = {"completed", "failed", "cancelled", "canceled", "closed"}
for line in root_events:
    if line.get("type") == "thread.started":
        root = line.get("thread_id") or line.get("id")
    if line.get("type") == "turn.completed":
        turn_finished = True
    item = line.get("item") or {}
    if str(item.get("type", "")).lower() in {"collabagenttoolcall", "collab_tool_call"}:
        states = item.get("agents_states") or {}
        for child in item.get("receiver_thread_ids") or []:
            state = states.get(child)
            if isinstance(state, dict):
                state = state.get("status")
            if isinstance(state, str) and state:
                reported_children[child] = state.lower()
if not root:
    print("Codex thread id is unavailable")
    raise SystemExit(0)
reasons = []
if not turn_finished:
    reasons.append(f"Codex turn {root} has not completed")

home = os.path.expanduser(os.environ.get("CODEX_HOME", "~/.codex"))
db_paths = [os.path.join(home, f"state_{n}.sqlite") for n in (5, 4, 3)]
children = {}
seen = {root}
frontier = [root]
while frontier:
    parent = frontier.pop()
    found = []
    for path in db_paths:
        if not os.path.exists(path):
            continue
        try:
            db = sqlite3.connect(f"file:{path}?mode=ro", uri=True)
            found.extend(db.execute(
                "select child_thread_id, status from thread_spawn_edges where parent_thread_id = ?",
                (parent,),
            ).fetchall())
            db.close()
        except sqlite3.Error:
            pass
    for child, status in found:
        children[child] = status
        if child not in seen:
            seen.add(child)
            frontier.append(child)

# The returned invocation includes the parent's own wait/close-agent results.
# They are more direct than the eventually-consistent SQLite edge state and
# still let us find a child even when the state database is briefly unreadable.
for child, status in reported_children.items():
    children.setdefault(child, status)
    seen.add(child)

paths = {source}
for thread_id in seen:
    for path in db_paths:
        if not os.path.exists(path):
            continue
        try:
            db = sqlite3.connect(f"file:{path}?mode=ro", uri=True)
            row = db.execute("select rollout_path from threads where id = ?", (thread_id,)).fetchone()
            db.close()
            if row and row[0]:
                paths.add(row[0])
        except sqlite3.Error:
            pass

def thread_state(path):
    """Return (terminal, active, live_commands) from a thread's own record.

    `thread_spawn_edges.status` is deliberately not used as liveness: it can
    remain `open` after `wait_agent` has returned a completed result.  The
    thread's terminal event is the evidence that the parent is no longer
    waiting for that subagent.
    """
    terminal = False
    last_event_at = None
    last_command_ended = False
    started, completed = {}, set()
    for event in events(path):
        kind = event.get("type")
        raw_time = event.get("_ralph_timestamp")
        if isinstance(raw_time, str):
            try:
                last_event_at = datetime.datetime.fromisoformat(raw_time.replace("Z", "+00:00"))
            except ValueError:
                pass
        if kind in {"turn_context", "thread.started"}:
            terminal = False
            last_command_ended = False
        elif kind == "task_complete":
            terminal = True
        item = event.get("item") or {}
        item_type = str(item.get("type", "")).lower()
        item_id = item.get("id")
        if item_type in {"commandexecution", "command_execution"} and item_id:
            if kind in {"item.started", "item_started"}:
                started[item_id] = item.get("process_id")
            elif kind in {"item.completed", "item_completed"}:
                completed.add(item_id)
                last_command_ended = True
    live = []
    if not terminal:
        for item_id, process_id in started.items():
            if item_id in completed or not process_id:
                continue
            try:
                os.kill(int(process_id), 0)
            except (OSError, ValueError):
                continue
            live.append((item_id, process_id))
    # A parent can finish while the platform is cancelling a child.  That
    # child has no task_complete, but its final CommandExecution is already a
    # terminal failed/cancelled item and it has no process to wait for.  Do not
    # turn that stale open edge into a 900-second wait.
    if terminal or last_command_ended:
        return True, False, live
    if last_event_at is None:
        return False, True, live
    now = datetime.datetime.now(datetime.timezone.utc)
    grace = int(os.environ.get("RALPH_CODEX_ACTIVITY_GRACE", "60"))
    active = (now - last_event_at).total_seconds() <= grace
    return False, active, live

# The invocation record is specific to the returned turn.  It is the source
# of truth for the parent command it might still be waiting on.
_, _, root_live = thread_state(source)
for item_id, process_id in root_live:
    reasons.append(f"Codex command {item_id} (pid {process_id}) is still running")

for child, status in children.items():
    if reported_children.get(child) in terminal_agent_statuses:
        continue
    child_path = None
    for path in db_paths:
        if not os.path.exists(path):
            continue
        try:
            db = sqlite3.connect(f"file:{path}?mode=ro", uri=True)
            row = db.execute("select rollout_path from threads where id = ?", (child,)).fetchone()
            db.close()
            if row and row[0]:
                child_path = row[0]
                break
        except sqlite3.Error:
            pass
    if not child_path:
        if status != "closed":
            reasons.append(f"Codex child turn {child} has no terminal record")
        continue
    terminal, active, live = thread_state(child_path)
    if not terminal and active:
        reasons.append(f"Codex child turn {child} has not completed")
    for item_id, process_id in live:
        reasons.append(f"Codex child command {item_id} (pid {process_id}) is still running")

if reasons:
    print("; ".join(dict.fromkeys(reasons)))
    raise SystemExit(0)
raise SystemExit(1)
PY
}

claude_pending_work() { # <Claude result JSON>; stdout = reasons
  local source="${1:-}"
  RALPH_CLAUDE_SOURCE="$source" RALPH_REPO_ROOT="$REPO_ROOT" python3 - <<'PY'
import json, os, subprocess, sys

source = os.environ.get("RALPH_CLAUDE_SOURCE", "")
root = None
try:
    root = json.load(open(source)).get("session_id")
except (OSError, ValueError, AttributeError):
    pass
if not root:
    print("Claude session id is unavailable")
    raise SystemExit(0)
try:
    raw = subprocess.check_output(
        ["claude", "agents", "--json", "--cwd", os.environ["RALPH_REPO_ROOT"]],
        text=True,
        stderr=subprocess.DEVNULL,
    )
    agents = json.loads(raw)
except (OSError, subprocess.SubprocessError, ValueError):
    print("Claude background-agent state is unavailable")
    raise SystemExit(0)
if not isinstance(agents, list):
    print("Claude background-agent state is malformed")
    raise SystemExit(0)

def get(agent, *names):
    for name in names:
        value = agent.get(name)
        if isinstance(value, str) and value:
            return value
    return None

by_parent = {}
unlinked = []
for agent in agents:
    if not isinstance(agent, dict):
        continue
    session_id = get(agent, "sessionId", "session_id", "id")
    parent_id = get(agent, "parentSessionId", "parent_session_id", "parentId", "parent_id")
    status = str(agent.get("status", "running")).lower()
    if status in {"completed", "failed", "cancelled", "canceled"}:
        continue
    if session_id and parent_id:
        by_parent.setdefault(parent_id, []).append((session_id, status))
    else:
        unlinked.append((session_id or "unknown", status))

reasons = []
frontier = [root]
seen = {root}
while frontier:
    parent = frontier.pop()
    for child, status in by_parent.get(parent, []):
        reasons.append(f"Claude child turn {child} is {status}")
        if child not in seen:
            seen.add(child)
            frontier.append(child)

# Older Claude versions do not include parent ids in `agents --json`. In that
# case every listed agent for this cwd is active, so refusing the promise is the
# safe choice; a false wait is preferable to committing over live work.
if unlinked and not by_parent:
    reasons.extend(f"Claude background turn {child} is {status}" for child, status in unlinked)

if reasons:
    print("; ".join(reasons))
    raise SystemExit(0)
raise SystemExit(1)
PY
}

# pi keeps one JSONL transcript per session under ~/.pi/agent/sessions/<encoded cwd>/
# (PI_CODING_AGENT_DIR and PI_CODING_AGENT_SESSION_DIR relocate it). Every assistant
# message in it carries the model, the token counts and the USD cost pi priced that
# one call at, so cost and context are read from the transcript and nothing else.
#
# Work a session farms out lands in OTHER transcripts, and the parent links to them in
# three ways, all recoverable from the parent's own file (measured 2026-09-01):
#   1. The Agent tool (pi-subagents) runs the child in-process and writes its session
#      with a "parentSession" header pointing at the parent's file. A nested agent
#      spawned by that child is NOT persisted; its cost survives only in the
#      "details.cost" of the parent's Agent tool result, which is used when no file
#      answers to the agent id.
#   2. `pi -p …` run from the bash tool starts a plain session with no parent link.
#      It is matched by its header timestamp falling between the assistant message
#      that issued the command and that command's tool result, in the sessions of the
#      same install (plus any --session-dir the command named). A `--mode json` child
#      also prints its header into the tool result, and a `--session-id` names itself.
#   3. bg_run (pi-background-tasks) starts the command detached and returns at once,
#      so its child begins AFTER the tool result. Every task writes
#      <cwd>/.pi/tasks/<session>-<pid>/<task>.json with pid, status, startTime and
#      endTime; that record is the window for a bg_run child, and its pid is what
#      pending-work checks. Without it the window closes at the task's
#      <background-task-notification>, or at the end of the transcript.
#   4. bg_delegate launches `pi --session-id <id> --session-dir <artifacts>/child-session`
#      and says so in its result ("Child session: <id>", "Artifacts: <dir>"), so the
#      child is found by id under that directory.
# One python program serves both the ledger and the quiescence check so they can never
# disagree on which transcripts belong to an iteration.
pi_transcript() { # <mode: usage|pending|children> <args...>
  python3 - "$@" <<'PY'
import datetime, glob, json, os, re, subprocess, sys

mode, argv = sys.argv[1], sys.argv[2:]
TERMINAL = {"completed", "failed", "cancelled", "canceled", "aborted", "killed", "error", "timeout", "timed_out"}
PI_RE = re.compile(r'(?:^|[\s;&|(`{])[\'"]?pi[\'"]?(?:\s|$)')
# Tools that return before the work they started, so a child of theirs begins after
# the tool result and the plain call-to-result window would never contain it.
BACKGROUND_TOOLS = {"bg_run", "bg_run_pi_attested", "bg_delegate"}
# Tools that launch a `pi` child even when their arguments carry no command line.
PI_LAUNCHERS = {"bg_delegate", "bg_run_pi_attested"}

def sessions_roots(extra=()):
    roots = []
    env = os.environ.get("PI_CODING_AGENT_SESSION_DIR")
    if env:
        roots.append(env)
    agent = os.environ.get("PI_CODING_AGENT_DIR") or os.path.join(os.path.expanduser("~"), ".pi", "agent")
    roots.append(os.path.join(agent, "sessions"))
    roots.extend(extra)
    seen, out = set(), []
    for r in roots:
        r = os.path.abspath(os.path.expanduser(r))
        if r not in seen:
            seen.add(r); out.append(r)
    return out

_headers = {}
def header(path):
    if path in _headers:
        return _headers[path]
    h = None
    try:
        with open(path, errors="replace") as fh:
            first = fh.readline()
        d = json.loads(first)
        if isinstance(d, dict) and d.get("type") == "session":
            h = d
    except (OSError, ValueError):
        pass
    _headers[path] = h
    return h

def session_files(roots):
    out = []
    for r in roots:
        out.extend(glob.glob(os.path.join(r, "**", "*.jsonl"), recursive=True))
    return sorted(set(os.path.abspath(p) for p in out))

def find_by_id(sid, roots):
    if not sid:
        return None
    for path in session_files(roots):
        if os.path.basename(path).endswith("_" + sid + ".jsonl") or os.path.basename(path) == sid + ".jsonl":
            return path
    for path in session_files(roots):
        h = header(path)
        if h and h.get("id") == sid:
            return path
    return None

def parse_ts(value):
    if isinstance(value, (int, float)):
        return datetime.datetime.fromtimestamp(value / 1000, datetime.timezone.utc)
    if isinstance(value, str):
        try:
            return datetime.datetime.fromisoformat(value.replace("Z", "+00:00"))
        except ValueError:
            return None
    return None

def entries(path):
    out = []
    try:
        with open(path, errors="replace") as fh:
            for line in fh:
                line = line.strip()
                if not line:
                    continue
                try:
                    out.append(json.loads(line))
                except ValueError:
                    continue   # a partially flushed final line
    except OSError:
        pass
    return out

def text_of(content):
    if isinstance(content, str):
        return content
    if isinstance(content, list):
        return "\n".join(c.get("text", "") for c in content if isinstance(c, dict) and c.get("type") == "text")
    return ""

def same_file(a, b):
    if not a or not b:
        return False
    if os.path.abspath(a) == os.path.abspath(b):
        return True
    try:
        return os.path.samefile(a, b)
    except OSError:
        return os.path.basename(a) == os.path.basename(b)

class Session:
    def __init__(self, path, kind, label):
        self.path, self.kind, self.label = path, kind, label
        self.header = header(path) or {}
        self.id = self.header.get("id")
        self.cwd = self.header.get("cwd") or ""
        self.name = None
        self.calls = []          # one per assistant message
        self.tool_calls = []     # (name, arguments, start_ts, end_ts, result_text, details)
        self.agent_status = {}   # subagents:record data.id -> status
        self.task_notified = {}  # background task id -> timestamp of its terminal notification
        self.children = []
        self.fallbacks = []      # (label, cost) for agents with no transcript
        self.last_ts = None
        self.turns = 0           # user messages seen; a resume starts a new one
        self.first_user = ""     # the prompt the session was started with
        self._parse()

    def _parse(self):
        pending = {}
        for e in entries(self.path):
            ts = parse_ts(e.get("timestamp"))
            if ts:
                self.last_ts = ts
            t = e.get("type")
            if t == "session_info" and e.get("name"):
                self.name = e["name"]
            elif t == "custom" and e.get("customType") == "subagents:record":
                data = e.get("data") or {}
                if data.get("id"):
                    self.agent_status[data["id"]] = str(data.get("status") or "").lower()
            elif t == "custom_message" and e.get("customType") == "background-task-notification":
                found = re.search(r"<task-id>\s*([^<\s]+)\s*</task-id>", text_of(e.get("content")))
                if found and ts:
                    self.task_notified[found.group(1)] = ts
            elif t == "message":
                m = e.get("message") or {}
                role = m.get("role")
                if role == "user":
                    self.turns += 1
                    if not self.first_user:
                        self.first_user = text_of(m.get("content"))
                if role == "assistant":
                    u = m.get("usage") or {}
                    cost = u.get("cost") or {}
                    self.calls.append({
                        "model": m.get("model") or "", "provider": m.get("provider") or "",
                        "in": int(u.get("input") or 0), "out": int(u.get("output") or 0),
                        "cr": int(u.get("cacheRead") or 0), "cw": int(u.get("cacheWrite") or 0),
                        "reasoning": int(u.get("reasoning") or 0),
                        "cost": float(cost.get("total") or 0),
                        "stop": m.get("stopReason") or "", "error": m.get("errorMessage") or "",
                    })
                    for c in m.get("content") or []:
                        if isinstance(c, dict) and c.get("type") == "toolCall":
                            pending[c.get("id")] = [c.get("name") or "", c.get("arguments") or {}, ts, None, "", None, self.turns]
                elif role == "toolResult":
                    rec = pending.pop(m.get("toolCallId"), None)
                    if rec is None:
                        rec = [m.get("toolName") or "", {}, None, None, "", None, self.turns]
                    rec[3] = ts
                    rec[4] = text_of(m.get("content"))
                    rec[5] = m.get("details") if isinstance(m.get("details"), dict) else None
                    self.tool_calls.append(tuple(rec))
        for rec in pending.values():   # a call whose result never landed (session cut off)
            self.tool_calls.append(tuple(rec))

    def cost(self):
        return sum(c["cost"] for c in self.calls)

    def model(self):
        return self.calls[-1]["model"] if self.calls else ""

    def last_error(self):
        if self.calls and self.calls[-1]["stop"] == "error":
            return self.calls[-1]["error"] or "error"
        return ""

    def background_agents_cut_off(self):
        """Agents backgrounded in the LAST turn that never reached a terminal record.

        Only the last turn counts: a resumed session was nudged to redo that work in
        the foreground, and the earlier record can never change afterwards, so
        holding it against every later promise would keep the slot failing forever
        (measured 2026-09-01: three refusals in a row on one resumed session).
        """
        out = []
        for name, args, _, _, _, details, turn in self.tool_calls:
            if turn != self.turns or name not in ("Agent", "Task") or not details:
                continue
            aid = details.get("agentId")
            status = str(details.get("status") or "").lower()
            if status != "background" or not aid:
                continue
            if self.agent_status.get(aid) in TERMINAL:
                continue
            out.append((aid, details.get("description") or args.get("description") or ""))
        return out

def command_of(args, details):
    """The command line a tool ran: its own argument, else the task record it returned
    (bg_delegate builds the child's argv itself and reports it only in details)."""
    for key in ("command", "cmd"):
        if isinstance(args, dict) and isinstance(args.get(key), str):
            return args[key]
    task = (details or {}).get("task")
    if isinstance(task, dict) and isinstance(task.get("command"), str):
        return task["command"]
    return ""

def task_id_of(args, details, result):
    task = (details or {}).get("task")
    if isinstance(task, dict) and task.get("id"):
        return str(task["id"])
    for key in ("task_id", "taskId"):
        if (details or {}).get(key):
            return str(details[key])
    found = re.search(r"^Started (?:background task|delegate) .*\(([^()\s]+)\)\s*$", result or "", re.M)
    return found.group(1) if found else None

def task_record(sess, task_id):
    """<cwd>/.pi/tasks/<session>-<pid>/<task>.json, written by pi-background-tasks."""
    if not (sess.cwd and sess.id and task_id):
        return None
    for path in glob.glob(os.path.join(glob.escape(sess.cwd), ".pi", "tasks", glob.escape(sess.id) + "-*", glob.escape(task_id) + ".json")):
        try:
            return json.load(open(path))
        except (OSError, ValueError):
            continue
    return None

def opt_values(command, flag):
    # Flags may be shell-quoted, as in the argv bg_delegate reports: '--session-id' 'x'.
    return re.findall(r'(?:^|\s)[\'"]?' + re.escape(flag) + r'[\'"]?(?:=|\s+)(?:"([^"]*)"|\'([^\']*)\'|(\S+))', command)

def opt_value_list(command, flag):
    return [a or b or c for a, b, c in opt_values(command, flag)]

def discover(root_path, roots):
    seen = {os.path.abspath(root_path)}
    files = session_files(roots)
    root = Session(root_path, "main", "main")
    def attach(sess):
        # 1. Agent children: files whose header names this file as parent.
        by_agent = {}
        for path in files:
            if path in seen:
                continue
            h = header(path)
            if not h or not same_file(h.get("parentSession"), sess.path):
                continue
            seen.add(path)
            child = Session(path, "agent", h.get("id"))
            child.label = child.name or (h.get("id") or "")[:8]
            sess.children.append(child)
            if child.name and "#" in child.name:
                by_agent[child.name.rsplit("#", 1)[1]] = child
        for name, args, start, end, result, details, _ in sess.tool_calls:
            if name in ("Agent", "Task") and details and details.get("agentId"):
                prefix = str(details["agentId"])[:8]
                if prefix in by_agent:
                    by_agent[prefix].label = f"{details.get('subagentType') or 'Agent'}#{prefix}"
                elif isinstance(details.get("cost"), (int, float)) and str(details.get("status", "")).lower() != "background":
                    sess.fallbacks.append((f"{details.get('subagentType') or 'Agent'}#{prefix}", float(details["cost"])))
        # 2. pi invocations from a shell or background tool. Explicit ids first; then the
        #    time windows, foreground calls before background ones because a bash window
        #    is exact (call to result) while a background one spans the whole task and
        #    would otherwise swallow a bash child started meanwhile.
        launches = []
        for name, args, start, end, result, details, _ in sess.tool_calls:
            # Only a tool that starts work may be a launch: bg_logs and bg_status echo
            # the task's command in their details without running anything.
            command = command_of(args, details if name in BACKGROUND_TOOLS or name in PI_LAUNCHERS else None)
            if not (name in PI_LAUNCHERS or (command and PI_RE.search(command))):
                continue
            launches.append((name in BACKGROUND_TOOLS, name, command, start, end, result or "", details))
        launches.sort(key=lambda item: item[0])
        for background, name, command, start, end, result, details in launches:
            extra = []
            for d in opt_value_list(command, "--session-dir"):
                d = os.path.expanduser(d)
                extra.append(d if os.path.isabs(d) else os.path.join(sess.cwd, d))
            for d in re.findall(r"^Artifacts:\s*(\S+)\s*$", result, re.M):
                d = os.path.expanduser(d)
                extra.append(d if os.path.isabs(d) else os.path.join(sess.cwd, d))
            local_roots = sessions_roots(extra)
            local_files = session_files(local_roots) if extra else files
            ids = list(opt_value_list(command, "--session-id"))
            ids.extend(re.findall(r"^Child session:\s*(\S+)", result, re.M))
            for line in result.splitlines():
                line = line.strip()
                if line.startswith("{") and '"type":"session"' in line.replace(" ", ""):
                    try:
                        d = json.loads(line)
                        if d.get("id"):
                            ids.append(d["id"])
                    except ValueError:
                        pass
            found = []
            for sid in ids:
                path = find_by_id(sid, local_roots)
                if path and path not in seen:
                    seen.add(path); found.append(path)
            # The launch's window: the task record's start and end when there is one,
            # else the call and its result (or the transcript's end for a background task).
            stop = end
            if background:
                record = task_record(sess, task_id_of({}, details, result)) or {}
                if record.get("startTime"):
                    start = parse_ts(record["startTime"]) or start
                if record.get("endTime"):
                    stop = parse_ts(record["endTime"])
                else:
                    stop = sess.task_notified.get(task_id_of({}, details, result) or "") or sess.last_ts
            stop = stop or sess.last_ts
            def in_window(h):
                hts = parse_ts(h.get("timestamp"))
                if hts is None or start is None or hts < start - datetime.timedelta(seconds=1):
                    return None
                if stop is not None and hts > stop + datetime.timedelta(seconds=1):
                    return None
                return hts
            # A child started on a prompt file — `pi -p "$(cat FILE)"` — is the session
            # whose first user message is that file's text, started inside the window.
            # Eighteen children launched in one second share one window; the prompt tells
            # them apart, and the window keeps an earlier pass's identical brief out.
            if not found:
                for f in re.findall(r'\$\(\s*cat\s+([^)\s"\']+)\s*\)', command):
                    fp = os.path.expanduser(f)
                    fp = fp if os.path.isabs(fp) else os.path.join(sess.cwd, fp)
                    try:
                        prompt = open(fp, errors="replace").read().strip()
                    except OSError:
                        continue
                    if not prompt:
                        continue
                    for path in local_files:
                        if path in seen:
                            continue
                        h = header(path)
                        if not h or h.get("parentSession") or in_window(h) is None:
                            continue
                        probe = Session(path, "", "")
                        if probe.first_user.strip()[:400] == prompt[:400]:
                            seen.add(path); found.append(path)
                            break
                    if found:
                        break
            if not found and "--no-session" not in command and start is not None:
                # The window only ever matches sessions started in the same directory as
                # the parent (a `cd` in the command counts): another project's session
                # that happens to start in the same minute is not this pass's child.
                cwds = {os.path.abspath(sess.cwd)} if sess.cwd else set()
                for d in re.findall(r"(?:^|[;&|(]\s*)cd\s+([^\s;&|]+)", command):
                    d = os.path.expanduser(d.strip("'\""))
                    cwds.add(os.path.abspath(d if os.path.isabs(d) else os.path.join(sess.cwd, d)))
                candidates = []
                for path in local_files:
                    if path in seen:
                        continue
                    h = header(path)
                    if not h or h.get("parentSession"):
                        continue
                    if cwds and os.path.abspath(h.get("cwd") or "") not in cwds:
                        continue
                    hts = in_window(h)
                    if hts is None:
                        continue
                    candidates.append((hts, path))
                # A background task runs one command, so it started one pi: the earliest
                # unclaimed session in its window. A shell call may have run several.
                candidates.sort()
                if background:
                    candidates = candidates[:1]
                for _, path in candidates:
                    seen.add(path); found.append(path)
            task_name = ((details or {}).get("task") or {}).get("name") if isinstance((details or {}).get("task"), dict) else None
            for path in found:
                child = Session(path, "pi -p" if name in ("bash", "shell") else name, (header(path) or {}).get("id"))
                # Session ids are time-ordered, so their first characters are the same
                # for every child of one pass; the task's name or the id's tail tells them apart.
                short_id = (child.id or "")[-8:]
                child.label = f"{child.kind} {task_name or short_id}"
                sess.children.append(child)
        for child in list(sess.children):
            attach(child)
    attach(root)
    return root

def walk(sess):
    yield sess
    for c in sess.children:
        yield from walk(c)

def context_window(model):
    """Ask pi's own catalogue; the transcript does not carry the window size."""
    if not model:
        return None
    try:
        out = subprocess.run(["pi", "--offline", "--list-models", model], capture_output=True, text=True, timeout=20).stdout
    except (OSError, subprocess.SubprocessError):
        return None
    for line in out.splitlines():
        parts = line.split()
        if len(parts) >= 3 and parts[1] == model:
            m = re.fullmatch(r"(\d+(?:\.\d+)?)([KM])", parts[2])
            if m:
                return int(float(m.group(1)) * (1_000_000 if m.group(2) == "M" else 1000))
    return None

def resolve_main(sources):
    """The last stdout JSON of an iteration names the session; earlier ones share it."""
    sid = cwd = None
    for src in reversed(sources):
        try:
            with open(src, errors="replace") as fh:
                for line in fh:
                    try:
                        d = json.loads(line)
                    except ValueError:
                        continue
                    if d.get("type") == "session":
                        sid, cwd = d.get("id"), d.get("cwd")
                        break
            if sid:
                break
        except OSError:
            continue
    if not sid:
        return None, None, None
    return sid, cwd, find_by_id(sid, sessions_roots())

if mode == "usage":
    sources = argv
    sid, cwd, path = resolve_main(sources)
    if not sid:
        print("- session record unavailable (no session header in the harness output)")
        raise SystemExit(0)
    if not path:
        print(f"- session {sid} has no transcript under {sessions_roots()[0]}")
        raise SystemExit(0)
    root = discover(path, sessions_roots())
    nodes = list(walk(root))
    subs = nodes[1:]
    main_cost = root.cost()
    sub_cost = sum(s.cost() for s in subs)
    fallbacks = [f for s in nodes for f in s.fallbacks]
    fallback_cost = sum(c for _, c in fallbacks)
    total = main_cost + sub_cost + fallback_cost
    line = f"- cost ${total:.4f} (summed from {len(nodes)} session transcript{'s' if len(nodes) != 1 else ''}: main ${main_cost:.4f}"
    if subs:
        line += f" · subagents ${sub_cost:.4f}"
    if fallbacks:
        line += f" · {len(fallbacks)} agent{'s' if len(fallbacks) != 1 else ''} without a transcript ${fallback_cost:.4f} from the parent's own record"
    print(line + ")")
    cost_file = os.environ.get("RALPH_PI_COST_FILE")
    if cost_file:
        with open(cost_file, "a") as fh:
            fh.write(f"{total:.4f}\n")
    tok = {k: sum(c[k] for s in nodes for c in s.calls) for k in ("in", "cr", "cw", "out", "reasoning")}
    print("- tokens input {in:,} · cache-read {cr:,} · cache-write {cw:,} · output {out:,} · reasoning {reasoning:,}".format(**tok))
    if root.calls:
        ctx = [c["in"] + c["cr"] + c["cw"] for c in root.calls]
        peak = max(ctx)
        win = context_window(root.model())
        of = pct = ""
        if win:
            of = f" of {win // 1_000_000}M" if win >= 1_000_000 else f" of {win // 1000}K"
            pct = f" ({round(peak * 100 / win)}%)"
        drops = sum(1 for i in range(1, len(ctx)) if ctx[i] < ctx[i - 1] * 0.8)
        shape = "monotonic" if not drops else f"{drops} drop(s), final {ctx[-1]:,}"
        if len(sources) > 1:
            shape += f", resumed {len(sources) - 1}x"
        print(f"- context {peak:,} tok peak{of}{pct} across {len(ctx)} inference calls, {shape}")
    by_model = {}
    for s in nodes:
        for c in s.calls:
            b = by_model.setdefault(c["model"] or "?", {"cost": 0.0, "in": 0, "out": 0, "cr": 0})
            b["cost"] += c["cost"]; b["in"] += c["in"]; b["out"] += c["out"] + c["reasoning"]; b["cr"] += c["cr"]
    if by_model:
        parts = []
        for name, b in sorted(by_model.items(), key=lambda kv: -kv[1]["cost"]):
            detail = f" (in {b['in']:,} / out {b['out']:,} / cache-read {b['cr']:,})" if not parts else ""
            parts.append(f"{name} ${b['cost']:.4f}{detail}")
        print("- models " + " · ".join(parts))
    if subs or fallbacks:
        kinds = {}
        for s in subs:
            kinds[s.kind] = kinds.get(s.kind, 0) + 1
        if fallbacks:
            kinds["agent (no transcript)"] = len(fallbacks)
        summary = " · ".join(f"{k} x{n}" for k, n in sorted(kinds.items(), key=lambda kv: -kv[1]))
        print(f"- subagents ({len(subs) + len(fallbacks)}) {summary}")
        for s in subs:
            print(f"  - {s.label}: {s.model() or '?'} ${s.cost():.4f}, {len(s.calls)} inference calls")
        for label, c in fallbacks:
            print(f"  - {label}: ${c:.4f} (nested, not persisted)")
    err = root.last_error()
    if err:
        print(f"- ended with an error: {err}")
    for s in subs:
        cut = s.background_agents_cut_off()
        for aid, desc in cut:
            print(f"- background agent {aid} ({desc}) in {s.label} never reached a terminal state")
    for aid, desc in root.background_agents_cut_off():
        print(f"- background agent {aid} ({desc}) never reached a terminal state")

elif mode == "pending":
    # argv: <meta json written by normalize_pi_result>
    try:
        meta = json.load(open(argv[0]))
    except (OSError, ValueError, IndexError):
        print("pi session record is unavailable")
        raise SystemExit(0)
    sid, path = meta.get("session_id"), meta.get("session_file")
    if not sid:
        print("pi session id is unavailable")
        raise SystemExit(0)
    if not path or not os.path.exists(path):
        path = find_by_id(sid, sessions_roots())
    if not path:
        print(f"pi session {sid} has no transcript")
        raise SystemExit(0)
    root = discover(path, sessions_roots())
    lost, live = [], []
    for s in walk(root):
        for aid, desc in s.background_agents_cut_off():
            where = "" if s is root else f" in {s.label}"
            lost.append(f"pi background agent {aid} ({desc}){where} was still running when the session exited")
    # Detached background tasks record their pid; only a live one is worth waiting for.
    for s in walk(root):
        if not s.cwd or not s.id:
            continue
        for meta_path in glob.glob(os.path.join(s.cwd, ".pi", "tasks", f"{s.id}-*", "*.json")):
            try:
                task = json.load(open(meta_path))
            except (OSError, ValueError):
                continue
            if str(task.get("status", "")).lower() != "running":
                continue
            pid = task.get("pid")
            try:
                os.kill(int(pid), 0)
            except (OSError, TypeError, ValueError):
                continue
            live.append(f"pi background task {task.get('id') or os.path.basename(meta_path)} (pid {pid}) is still running")
    if lost:
        print("lost: " + "; ".join(dict.fromkeys(lost + live)))
        raise SystemExit(0)
    if live:
        print("; ".join(dict.fromkeys(live)))
        raise SystemExit(0)
    raise SystemExit(1)

elif mode == "children":
    # argv: <session file> — one line per transcript in the tree, for inspection and tests.
    root = discover(argv[0], sessions_roots())
    for s in walk(root):
        print(f"{s.kind}\t{s.id}\t{s.model()}\t{s.cost():.4f}\t{s.path}")
    for s in walk(root):
        for label, c in s.fallbacks:
            print(f"fallback\t{label}\t\t{c:.4f}\t")
else:
    raise SystemExit(f"pi_transcript: unknown mode {mode}")
PY
}

pi_pending_work() { # <normalized pi result (.meta)>; stdout = reasons, "lost: …" when unrecoverable
  pi_transcript pending "${1:-}"
}

harness_pending_work() { # <raw harness result>; stdout = reasons
  case "$HARNESS" in
    pi)    pi_pending_work "$1" ;;
    codex) codex_pending_work "$1" ;;
    *)     claude_pending_work "$1" ;;
  esac
}

await_harness_quiescence() { # <raw harness result> <label>
  local source="${1:-}" label="${2:-}" waited=0 pending
  while pending="$(harness_pending_work "$source")"; do
    # Work the harness process took down with it cannot finish however long we wait;
    # refusing the promise at once sends the iteration into the resume path, whose
    # nudge is to redo that work in the foreground.
    if [[ "$pending" == lost:* ]]; then
      say "session [$label] returned a promise after discarding work — refusing it (${pending#lost: })"
      note "[ralph] session [$label] ended with backgrounded work unfinished (${pending#lost: }); its promise was not accepted."
      return 1
    fi
    if (( waited == 0 )); then
      say "session [$label] returned a promise with live harness work — waiting"
      note "[ralph] session [$label] returned a promise while harness work remained; waiting before accepting it."
    fi
    if (( waited >= GROUP_WAIT_MAX )); then
      say "harness work for [$label] remained after ${waited}s — refusing its promise"
      note "[ralph] session [$label] still had harness work after ${waited}s; its promise was not accepted."
      return 1
    fi
    sleep 5
    waited=$(( waited + 5 ))
  done
  (( waited > 0 )) && say "harness work in [$label] finished after ${waited}s"
  return 0
}

watchdog() { # <pid> <label>
  local pid="$1" label="$2" start last now idle
  start=$(date +%s)
  while kill -0 "$pid" 2>/dev/null; do
    sleep 30
    kill -0 "$pid" 2>/dev/null || return 0
    [[ "$WATCHDOG" -le 0 ]] && continue
    last=$(stat -c %Y "$PROGRESS" 2>/dev/null || stat -f %m "$PROGRESS" 2>/dev/null || echo "$start")
    (( last < start )) && last=$start
    now=$(date +%s); idle=$(( now - last ))
    if (( idle > WATCHDOG )); then
      say "watchdog: no $PROGRESS append in ${idle}s — terminating [$label]"
      note "[ralph watchdog] no progress append in ${idle}s — session [$label] SIGTERMed mid-work."
      local wpg; wpg="$(ps -o pgid= -p "$pid" 2>/dev/null | tr -d ' ')"
      if [ -n "$wpg" ]; then kill -TERM -"$wpg" 2>/dev/null; sleep 20; kill -KILL -"$wpg" 2>/dev/null
      else kill -TERM "$pid" 2>/dev/null; sleep 20; kill -KILL "$pid" 2>/dev/null; fi
      return 1
    fi
  done
}

# Usage accounting. Self-contained: the python below reads the session JSON that
# `claude -p --output-format json` wrote and, from it, that session's transcript
# and its subagents' transcripts.
#
# WHAT IS EXACT AND WHAT IS NOT (measured against the server 2026-07-24):
#   cost and per-model totals come from the session JSON (total_cost_usd,
#   modelUsage) — server-computed, already covering subagents and thinking tokens.
#   Context, input and cache figures are read from the transcripts and match the
#   server exactly. Output tokens do NOT: with thinking display omitted (the
#   default on Opus 5 / Sonnet 5) thinking blocks are written with empty text and
#   no field carries their count, so a subagent showed 149 recorded output tokens
#   against 9,481 billed. Output is therefore never reported per subagent.
#
# Context size for one inference call is input + cache_read + cache_creation:
# every prompt token is billed exactly once into one of those three buckets, so
# their sum is the whole prompt the model saw. Peak across calls is the headline;
# a mid-session DROP means auto-compaction fired, which is worth seeing in the log.
# log_usage <label> <json-file>... — one entry per ITERATION, not per invocation.
# A resumed turn writes its own session JSON with its own total_cost_usd covering
# only that turn (measured: $0.1008 for the first turn, $0.0150 for the resume), so
# the cost and modelUsage figures are SUMMED across every JSON of the iteration. The
# transcript is not: --resume appends to the same ~/.claude/projects/<cwd>/<sid>.jsonl,
# so context peak and inference-call count are already whole-iteration figures and are
# read from the last JSON's session_id alone.
