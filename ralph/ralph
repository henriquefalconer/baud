# with no percentage rather than guessing.

def base(model):
    """Strip the [1m] variant marker and any -YYYYMMDD snapshot suffix."""
    m = (model or "").split("[")[0]
    parts = m.rsplit("-", 1)
    return parts[0] if len(parts) == 2 and parts[1].isdigit() and len(parts[1]) == 8 else m

