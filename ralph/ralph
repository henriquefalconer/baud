# pi's `--mode json` stdout is a stream of events, not one result object. This
# reduces it to the same shape normalize_codex_result produces, so the resume and
# promise paths read every harness alike. The process exits 0 even when the model
# call failed (measured: an unknown model id returns rc=0 with stopReason "error"
# on the assistant message), so is_error comes from the message, never from rc.
normalize_pi_result() { # <stdout jsonl> <normalized-json>
  python3 - "$1" "$2" <<'PY'
import glob, json, os, sys

sid = cwd = None
last = None          # last assistant message seen on stdout
saw_assistant = False
try:
    lines = open(sys.argv[1], errors="replace")
except OSError:
    lines = []
for line in lines:
    try:
        event = json.loads(line)
    except (ValueError, TypeError):
        continue
    if event.get("type") == "session":
        sid, cwd = event.get("id"), event.get("cwd")
    # The last assistant message WITH TEXT is the result: a background task's
    # terminal notification wakes one more turn after the promise, and that turn is
    # empty (measured: 21 of them after one COMPLETE), so the last message alone
    # would read as "no promise" and send a finished iteration into a resume.
    def spoken(m):
        return any(isinstance(c, dict) and c.get("type") == "text" and c.get("text", "").strip() for c in (m.get("content") or []))
    msg = event.get("message") if event.get("type") in ("message_end", "turn_end") else None
    if isinstance(msg, dict) and msg.get("role") == "assistant":
        saw_assistant = True
        if spoken(msg) or last is None or msg.get("stopReason") == "error":
            last = msg
    if event.get("type") == "agent_end":
        for m in event.get("messages") or []:
            if isinstance(m, dict) and m.get("role") == "assistant":
                saw_assistant = True
                if spoken(m) or last is None or m.get("stopReason") == "error":
                    last = m
if not sid:
    raise SystemExit(1)

roots = []
if os.environ.get("PI_CODING_AGENT_SESSION_DIR"):
    roots.append(os.environ["PI_CODING_AGENT_SESSION_DIR"])
roots.append(os.path.join(os.environ.get("PI_CODING_AGENT_DIR") or os.path.join(os.path.expanduser("~"), ".pi", "agent"), "sessions"))
session_file = None
for root in roots:
    hits = glob.glob(os.path.join(os.path.expanduser(root), "**", "*_" + sid + ".jsonl"), recursive=True)
    if hits:
        session_file = os.path.abspath(sorted(hits)[0])
        break

def text_of(m):
    return "\n".join(c.get("text", "") for c in (m.get("content") or []) if isinstance(c, dict) and c.get("type") == "text")

# stdout is cut short when pi dies mid-turn; the transcript on disk still has what
# it managed to say, so read the last assistant message from there in that case.
if last is None and session_file:
    try:
        for line in open(session_file, errors="replace"):
            try:
                e = json.loads(line)
            except ValueError:
                continue
            m = e.get("message") if e.get("type") == "message" else None
            if isinstance(m, dict) and m.get("role") == "assistant":
                saw_assistant = True
                if spoken(m) or last is None:
                    last = m
    except OSError:
        pass

stop = (last or {}).get("stopReason") or ""
failed = (not saw_assistant) or stop == "error"
json.dump({
    "session_id": sid,
    "cwd": cwd,
    "session_file": session_file,
    "is_error": failed,
    "stop_reason": stop,
    "error": (last or {}).get("errorMessage") or "",
    "result": text_of(last) if last else "",
}, open(sys.argv[2], "w"))
PY
}

# run_session <label> <prompt-file> — writes the session's final text to
# $RESULT_FILE. Do NOT call inside $( ): see the RESULT_FILE note above.
run_session() {
  local label="$1" pf="$2" sid="${3:-}" out rc pid pgid t0 result_file
  local -a resume_args=()
  # Codex resumes with a subcommand; the other two take a flag, and pi's is --session,
  # which reopens the same transcript file (verified: the resumed turn appends to it).
  if [[ -n "$sid" ]]; then
    case "$HARNESS" in
      pi)     resume_args=( --session "$sid" ) ;;
      claude) resume_args=( --resume "$sid" ) ;;
    esac
  fi
  SESSION_N=$((SESSION_N + 1))
  t0=$(date +%s)
  out="$RUNDIR/$(printf '%03d' "$SESSION_N")-$label.json"
  LAST_JSON="$out"
  LAST_RAW_JSON="$out"
  if [ -n "$sid" ]; then
    say "session $SESSION_N [$label] RESUMING $sid (model=$MODEL_LABEL)"
  else
    say "session $SESSION_N [$label] starting (model=$MODEL_LABEL)"
  fi
  result_file="$RUNDIR/$(printf '%03d' "$SESSION_N")-$label.result.txt"
  if [[ "$HARNESS" == codex ]]; then
    if [ -n "$sid" ]; then
      codex exec resume "$sid" "${HARNESS_ARGS[@]}" -o "$result_file" < "$pf" > "$out" 2> "$out.err" &
    else
      codex exec "${HARNESS_ARGS[@]}" -o "$result_file" < "$pf" > "$out" 2> "$out.err" &
    fi
  elif [[ "$HARNESS" == pi ]]; then
    # A child the session starts with `pi -p` reads these to run on the same model and
    # level as its parent; the prompts name them as $RALPH_MODEL / $RALPH_THINKING.
    RALPH_MODEL="$MODEL" RALPH_THINKING="$THINKING" \
      pi "${HARNESS_ARGS[@]}" ${resume_args[@]+"${resume_args[@]}"} < "$pf" > "$out" 2> "$out.err" &
  else
    claude "${HARNESS_ARGS[@]}" ${resume_args[@]+"${resume_args[@]}"} < "$pf" > "$out" 2> "$out.err" &
  fi
  pid=$!
  pgid="$(ps -o pgid= -p "$pid" 2>/dev/null | tr -d ' ')"
  [ -n "$pgid" ] && SESSION_PGIDS="$SESSION_PGIDS $pgid"
  watchdog "$pid" "$label"
  wait "$pid"; rc=$?
  # `wait` returns when THIS claude exits; subagents it spawned live on.
  await_group "$pgid" "$label"
  SESSION_SECS=$(( $(date +%s) - t0 ))   # read by log_usage for the header
  ITER_JSONS+=( "$out" )
  ITER_SECS=$(( ITER_SECS + SESSION_SECS ))
  # A deferred caller (the ralph loop, which may resume this same session several
  # times) logs once for the whole iteration instead of once per invocation.
  if (( USAGE_DEFERRED )); then
    :
  else
    log_usage "$label" "$out"
  fi
  (( rc != 0 )) && say "session [$label] exited rc=$rc — see $out.err"
  if [[ "$HARNESS" == codex ]]; then
    normalize_codex_result "$out" "$out.meta" 2>/dev/null || : > "$out.meta"
    LAST_JSON="$out.meta"
    cp "$result_file" "$RESULT_FILE" 2>/dev/null || : > "$RESULT_FILE"
  elif [[ "$HARNESS" == pi ]]; then
    normalize_pi_result "$out" "$out.meta" 2>/dev/null || : > "$out.meta"
    LAST_JSON="$out.meta"
    LAST_RAW_JSON="$out.meta"
    jsonfield "$out.meta" result > "$RESULT_FILE" 2>/dev/null || : > "$RESULT_FILE"
  else
    jsonfield "$out" result > "$RESULT_FILE" 2>/dev/null || : > "$RESULT_FILE"
  fi
  return 0
}

# ── prompt assembly ──────────────────────────────────────────────────────────

# The exact select: list matters — it is ONE ToolSearch call, not a search. And
# "a single subagent for ralph/tests" is deliberate backpressure on ralph runs,
# not a stylistic choice.
# The tools a session has differ by harness, and a prompt that names the wrong ones
# sends the model looking for a ToolSearch it does not have. Each note names what is
# actually there. On pi the browser is ralph/pi-chrome (installed as a pi package) and
# a subagent is a `pi -p` child under bg_run, since that is what the transcript ledger
# and the quiescence check follow.
env_note() {
  if [[ "$HARNESS" == pi ]]; then
    cat <<'ENVNOTE'

## Environment
- Repo: the current working directory. Stack per the specs and CLAUDE.md.
- You run with full permissions. Nothing asks you to confirm a tool call.
- The bash tool's `timeout` is in SECONDS here, 600 at most for anything you wait on; a prompt written for a harness that counts milliseconds ("600000 ms") means 600 on this one, and 600000 would be a week.
- Browser: the chrome_* tools own a real Chrome window. chrome_open gives a tabId; chrome_eval returns JSON from the page (measure with it, never from a screenshot); chrome_input sends real clicks, hovers and keys; chrome_tabs resizes, lists and closes. A chrome_eval is aborted after its timeoutMs (600000 at most), so a job that runs for minutes must detach itself and be polled. Open new tabs; never reuse a tabId from an earlier session. Close every tab you opened.
- Subagents: start one as a background task running pi — `bg_run` with isAgent true and the command `pi -p --model "$RALPH_MODEL" --thinking "$RALPH_THINKING" "$(cat /path/to/prompt.txt)"` (both variables are set in your environment; write the prompt to a file first, and pass it as the argument — the task runner gives the child no stdin, so `< file` reaches nothing). It has the same tools you have, including the browser. Its result arrives as a <background-task-notification> **while you keep working** — in this headless run, ending your turn exits the process and kills every background task, so a notification can never wake you afterwards. Never end your turn to wait for a task; wait inside the turn by running `sleep 30` in bash (one call at a time, never past 600 s) and checking bg_status until the task has finished. The same holds for a server you start with bg_run: it lives exactly as long as your turn. bg_delegate is read-only (no bash, no browser) and fits study and searches only. Use parallel children for study and searches, a single child for ralph/tests (backpressure), children for complex reasoning — and wait for every one of them before you finish, since nothing you started survives your exit.
ENVNOTE
    return
  fi
  cat <<'ENVNOTE'

## Environment
- Repo: the current working directory. Stack per the specs and CLAUDE.md.
- You run with full permissions and Chrome attached.
- Browser/computer use: when verifying user-facing or HTTP behavior, load the browser tools in ONE ToolSearch call and drive the app in a real tab; use the computer tool for screenshots/clicks as needed. Create new tabs; never reuse old tab IDs.
- If no browser is attached, you may search this filesystem for a Chrome or Chromium executable and launch it yourself, then carry on with the browser automation tools.
- Use subagents (Agent tool) as your prompt instructs: parallel subagents for study/searches, a single subagent for ralph/tests (backpressure), subagents for complex reasoning.
ENVNOTE
}

ralph_prompt_file() { # <iter> <extra-context> -> prints path
  # Split, not one `local`: bash expands every word of a `local` line before the
  # builtin assigns any of them, so a later word referring to an earlier one is
  # unbound under `set -u`.
  local iter="$1" extra="$2" f
  f="$RUNDIR/${PROMPT_NAME%.md}-$iter.txt"
  sed "s/\[ralph-iteration\]/$iter/g" "$PROMPT_FILE" > "$f"
  {
    printf '\n\n## Orchestrator notes (these refine, never override, the instructions above)\n'
    printf -- '- This is Ralph iteration %s. Every "[ralph-iteration]" above is already %s.\n' "$iter" "$iter"
    printf -- '- You are a fresh, clean-context session: all continuity is on disk (%s, git history). Study before assuming.\n' "$PROGRESS"
    if [[ "$WATCHDOG" -gt 0 ]]; then
      printf -- '- This session is terminated after %s seconds with no append to %s. Narrate as you go.\n' "$WATCHDOG" "$PROGRESS"
    else
      printf -- '- There is no idle timeout on this session. Still append to %s as you go: it is the only continuity the next iteration has.\n' "$PROGRESS"
    fi
    printf -- '- Your final message is parsed by the orchestrator for the promise tag ONLY: end with <promise>NEXT</promise> or <promise>COMPLETE</promise> and stop. A missing tag counts as an abnormal exit.\n'
    [[ -n "$extra" ]] && printf -- '\n### Context from the orchestrator\n%s\n' "$extra"
    env_note
  } >> "$f"
  printf '%s' "$f"
}

# ── the ralph loop ───────────────────────────────────────────────────────────

ITER=1

ralph_loop() { # <phase-label> <extra-context> -> 0 = COMPLETE, 1 = stopped
  local phase="$1" extra="$2" fails=0 pf out p
  while :; do
    if (( MAX_ITER > 0 && ITER > MAX_ITER )); then
      say "reached max iterations ($MAX_ITER) without COMPLETE — stopping"
      return 1
    fi
    if budget_exhausted; then
      say "budget target nearly exhausted (\$$(spent_usd) of \$$BUDGET_TOTAL_USD) — pausing the loop"
      note "[ralph] budget target nearly exhausted — loop paused before iteration $ITER."
      return 1
    fi
    pf="$(ralph_prompt_file "$ITER" "$extra")"
    # One iteration may take several `claude -p` invocations — the first, plus a
    # resume for each time it ends its turn on a backgrounded command. They are one
    # unit of work on one session id, so usage is accumulated and written once, at
    # the end, instead of once per invocation.
    begin_iteration_usage
    run_session "ralph-$ITER" "$pf"
    out="$(cat "$RESULT_FILE")"
    p="$(promise_of "$out")"
    if [[ -n "$p" ]] && ! await_harness_quiescence "$LAST_RAW_JSON" "ralph-$ITER"; then
      p=""
    fi

    # A missing tag almost always means the turn ended waiting on a command that -p
    # then killed. Resuming costs one short turn and keeps everything the session
    # already did; restarting the slot throws all of it away. Bounded only to stop a
    # session that cannot finish from looping forever.
    local sid rp tries=0
    while [[ -z "$p" ]] && (( tries < RESUME_MAX )); do
      sid="$(resumable_session_id "$LAST_JSON")" || break
      [ -n "$sid" ] || break
      tries=$((tries + 1))
      say "iteration $ITER [$phase]: no promise tag — resuming session $sid (resume $tries/$RESUME_MAX)"
      rp="$RUNDIR/prompt-resume-$ITER-$tries.txt"
      write_resume_prompt "$rp"
      run_session "ralph-$ITER" "$rp" "$sid"
      out="$(cat "$RESULT_FILE")"
      p="$(promise_of "$out")"
      if [[ -n "$p" ]] && ! await_harness_quiescence "$LAST_RAW_JSON" "ralph-$ITER"; then
        p=""
      fi
    done

    if [[ -z "$p" ]]; then
      flush_iteration_usage "ralph-$ITER"
      if session_budget_exhausted; then
        say "session budget exceeded (\$$BUDGET_USD cap; actual \$$(spent_usd)) — stopping"
        return 1
      fi
      fails=$((fails + 1))
      say "iteration $ITER [$phase]: still no promise tag after $tries resume(s) ($fails/3 consecutive) — retrying the slot"
      (( fails >= 3 )) && { say "aborting: 3 consecutive abnormal exits at iteration $ITER"; return 1; }
      continue
    fi
    flush_iteration_usage "ralph-$ITER"
    if session_budget_exhausted; then
      say "session budget exceeded (\$$BUDGET_USD cap; actual \$$(spent_usd)) — stopping"
      return 1
    fi
    fails=0
    say "iteration $ITER [$phase] -> <promise>$p</promise>"
    ITER=$((ITER + 1))
    [[ "$p" == COMPLETE ]] && return 0
  done
}
say "run directory: $RUNDIR"
note "═══════════════════════════════════════════════════════"
note "ralph (shell loop) starting — harness=$HARNESS prompt=$PROMPT_NAME model=$MODEL thinking=${THINKING:-<cli default>} max-iter=${MAX_ITER:-∞} watchdog=${WATCHDOG}s"
say "ralph loop starting"
ralph_loop Ralph ""; ralph_rc=$?

TOTAL_COST="$(spent_usd)"

{
  printf '\n## %s UTC - RUN TOTALS (ralph shell loop)\n' "$(date -u +%Y-%m-%dT%H:%M:%S)"
  printf -- '- sessions: %s; ralph iterations: %s\n' "$SESSION_N" "$((ITER - 1))"
  printf -- '- ralph ended %s\n' "$( ((ralph_rc == 0)) && echo COMPLETE || echo 'with items outstanding')"
  printf -- '- total cost $%s (summed from session usage)\n' "$TOTAL_COST"
  printf -- '---\n'
} >> "$PROGRESS"
say "run totals: $SESSION_N session(s), \$$TOTAL_COST"

# Commit the ledger so it is never left sitting uncommitted in the working tree.
git add -A && git commit -q -m "ralph: run totals" && git push -q \
  && say "run totals committed and pushed" \
  || say "run totals written to $PROGRESS but not committed (nothing to commit, or push failed)"

if (( ralph_rc != 0 )); then
  say "stopped during Ralph after $((ITER - 1)) iteration(s)"
  exit 1
fi
say "ralph reported COMPLETE after $((ITER - 1)) iteration(s)"
exit 0
