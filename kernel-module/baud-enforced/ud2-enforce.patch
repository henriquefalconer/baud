+/*
+ * baud: #UD already causes a VM-exit with no patch at all --
+ * vmx_update_exception_bitmap above unconditionally includes UD_VECTOR in the
+ * exception bitmap (stock KVM needs the trap for its own software-instruction
+ * emulation fallback), so EXIT_REASON_EXCEPTION_NMI -> handle_exception_nmi ->
+ * is_invalid_opcode() below is already the one and only path a guest #UD takes.
+ * No exec-control/exception-bitmap change is needed here, unlike RDTSC's
+ * CPU_BASED_RDTSC_EXITING (vmx_exec_control above).
+ *
+ * baud's build-time pass rewrites every RDSEED opcode in the guest image to
+ * UD2 (0F 0B) plus NOP padding, length-preserving (crates/baud-packages/src/
+ * rdseed.rs, todo.md §4), so the real RDSEED instruction never executes in the
+ * guest and SECONDARY_EXEC_RDSEED_EXITING -- which this host's VMX microcode
+ * does not even expose (kernel-module/baud-enforced/BUILD.md's probe report) --
+ * is not needed for RDSEED enforcement at all. This handler is what turns the
+ * resulting UD2 trap back into a served value.
+ *
+ * Two things this handler must NOT break:
+ *
+ *  - A bare UD2 is *also* how the Linux kernel's own BUG()/WARN_ON() compile,
+ *    and any genuinely invalid opcode raises the same #UD. Only userspace holds
+ *    the image-specific table of confirmed rewrite sites, so anything this
+ *    handler cannot positively identify as a UD2 falls straight through to
+ *    handle_ud() unchanged (and userspace re-injects #UD via
+ *    KVM_SET_VCPU_EVENTS for a UD2 that is not in its site table).
+ *
+ *  - RIP is deliberately left pointing *at* the trapping UD2 --
+ *    kvm_skip_emulated_instruction() is never called, unlike
+ *    handle_baud_rdtsc_exit/handle_baud_rdrand_exit below. Only userspace's
+ *    site table knows how far a confirmed site's UD2+NOP padding actually
+ *    extends (3 bytes for RDSEED r32, 4 for r64), and a site that turns out to
+ *    be a genuine #UD instead must be re-injected at exactly the RIP a native,
+ *    un-intercepted fault would have reported. Userspace advances RIP itself
+ *    (KVM_SET_REGS) when it serves a value.
+ *
+ * The payload is the same kvm_run.hw.hardware_exit_reason scratch u64 the other
+ * two handlers use; low byte 2 == UD2. No destination-register index is packed
+ * in (unlike RDRAND's): the original RDSEED's destination was decoded at
+ * *build* time and is nowhere in the trap -- the UD2 that replaced it encodes
+ * nothing -- so userspace recovers it from its own site table, keyed by RIP.
+ */
+static int handle_baud_ud2_exit(struct kvm_vcpu *vcpu)
+{
+	struct x86_exception e;
+	u8 opcode[2];
+
+	/*
+	 * Same read handle_ud() itself already does for its force-emulation-
+	 * prefix signature check (arch/x86/kvm/x86.c): a real x86_exception is
+	 * passed, not NULL -- kvm_read_guest_virt_helper writes through that
+	 * pointer unconditionally on a failed access. A failed read is not an
+	 * error here, just "not identifiable as ours".
+	 */
+	if (kvm_read_guest_virt(vcpu, kvm_get_linear_rip(vcpu), opcode,
+				sizeof(opcode), &e) != 0)
+		return handle_ud(vcpu);
+
+	if (opcode[0] != 0x0f || opcode[1] != 0x0b)
+		return handle_ud(vcpu);
+
+	vcpu->run->exit_reason = KVM_EXIT_BAUD_DETERMINISM;
+	vcpu->run->hw.hardware_exit_reason = 2; /* 2 == UD2 */
+	return 0;
+}
+
 static int handle_exception_nmi(struct kvm_vcpu *vcpu)
 {
 	struct vcpu_vmx *vmx = to_vmx(vcpu);
@@ -5209,8 +5274,13 @@
